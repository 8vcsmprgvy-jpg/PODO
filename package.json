{
  "name": "pomodoro-timer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm-run-all -p dev \"electron:dev --wait\"",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:dev --wait": "wait-on http://localhost:5173 && npm run electron:dev",
    "build:electron": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.pomodoro.timer",
    "productName": "Pomodore Timer",
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity",
      "icon": "electron/app-icon.icns"
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/tray-icon.png",
        "to": "tray-icon.png"
      }
    ]
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}